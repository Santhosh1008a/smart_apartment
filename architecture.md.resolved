### 1.3 Key Indexes

```sql
-- Performance-critical indexes
CREATE INDEX idx_users_email          ON users (email);
CREATE INDEX idx_users_phone          ON users (phone);
CREATE INDEX idx_user_units_user      ON user_units (user_id);
CREATE INDEX idx_invoices_unit_status ON invoices (unit_id, status);
CREATE INDEX idx_invoices_due_date    ON invoices (due_date) WHERE status IN ('sent','overdue');
CREATE INDEX idx_payments_invoice     ON payments (invoice_id);
CREATE INDEX idx_visitor_passes_host  ON visitor_passes (host_user_id, status);
CREATE INDEX idx_qr_token             ON qr_codes (token);
CREATE INDEX idx_emergency_active     ON emergency_alerts (status) WHERE status = 'active';
CREATE INDEX idx_audit_entity         ON audit_log (entity_type, entity_id);
CREATE INDEX idx_notifications_user   ON notifications (user_id, is_read);
```

