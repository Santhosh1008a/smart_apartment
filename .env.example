# Copy to .env for local development. Never put real values in this sample.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/syncliving
# TLS and certificate validation are always enabled. For Supabase pooler URLs,
# place the project CA in certs/ and set a path relative to the project root.
DATABASE_SSL=true
DATABASE_SSL_CA=certs/prod-ca-2021.crt
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SUPABASE_AVATAR_BUCKET=avatars

CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
ENABLE_API_DOCS=false
REDIS_URL=redis://localhost:6379
SENTRY_DSN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MONTHLY_MAINTENANCE_AMOUNT=
ENABLE_UNIFORM_MONTHLY_MAINTENANCE_INVOICES=false
ENABLE_IN_PROCESS_SCHEDULER=false
GEMINI_API_KEY=
GEMINI_MODEL=
ASSISTANT_DEBUG=false
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=

# Production registration stays disabled until provider details and reviewed,
# versioned legal notices are configured.
LEGAL_NOTICES_APPROVED=false
SERVICE_PROVIDER_NAME=
SERVICE_PROVIDER_ADDRESS=
SUPPORT_EMAIL=
PRIVACY_CONTACT_EMAIL=
TERMS_NOTICE_VERSION=draft-2026-10-04
PRIVACY_NOTICE_VERSION=draft-2026-10-04
